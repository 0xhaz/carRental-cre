# Deployment Configuration
# Copy this file to .env and fill in your values

# Deployer Private Key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Contract Owner Address
OWNER=0xYourOwnerAddressHere

# Sepolia RPC URL (get from Alchemy, Infura, or QuickNode)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Etherscan API Key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Bank address for MultiSigWallet (defaults to OWNER if not set)
BANK_ADDRESS=0xYourBankAddressHere

# Chainlink CRE Forwarder address (required for Phase 8)
# Get from Chainlink docs for your target chain
CRE_FORWARDER=0xChainlinkForwarderAddressHere
